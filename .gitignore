# Gizli bilgiler
.env
.env.*
!config/.env.example

# Çalışma zamanı verisi (yüklenen medya, oturum, günlük, yedek)
/storage/logs/*
/storage/cache/*
/storage/oturum/*
/storage/yuklemeler/*
/storage/yedekler/*
