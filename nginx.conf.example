server {
    listen 80;
    server_name ornek.com www.ornek.com;
    # Üretimde HTTPS'e yönlendirin ve TLS sertifikası ekleyin (certbot).
    root /var/www/portfolyo/public;
    index index.php;

    # Video yükleme için (YUKLEME_VIDEO_MAX_MB + form payı). PHP-FPM tarafında da upload_max_filesize ve
    # post_max_size en az bu kadar olmalıdır (docs/KURULUM.md → "Yükleme sınırları").
    client_max_body_size 72m;
    fastcgi_read_timeout 120s;
    server_tokens off;

    # Gzip sıkıştırma
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/javascript application/json image/svg+xml;

    # Statik varlıklar (immutable, uzun ömürlü önbellek)
    location /assets/ {
        try_files $uri =404;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff";
    }

    # robots.txt, sitemap.xml ve rss.xml uygulama tarafından dinamik üretilir (front controller).

    # Front controller
    location / {
        try_files $uri /index.php$is_args$args;
    }

    # Yalnızca index.php çalıştırılır; başka .php dosyası istenirse 404
    location = /index.php {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_PROXY "";
    }
    location ~ \.php$ { return 404; }

    # Gizli dosyalar
    location ~ /\. { deny all; }
}
