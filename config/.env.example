# Bu dosyayı proje KÖKÜNE ".env" adıyla kopyalayın:  cp config/.env.example .env   (Windows: copy config\.env.example .env)
# .env asla git'e eklenmez. Gizli değerleri (parola, anahtar) yalnızca .env içine yazın.

# --- Uygulama ---------------------------------------------------------------
# Canlıda: APP_ENV=production, APP_DEBUG=false, APP_URL=https://alanadiniz.com
APP_ENV=local
APP_DEBUG=true
# XAMPP alt klasörü: http://localhost/portfolyo   ·   php -S: http://localhost:8000   ·   Docker: http://localhost:8080
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Istanbul

# --- Veritabanı (MySQL 8 / MariaDB 10.6+) -------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolyo
DB_KULLANICI=root
DB_SIFRE=

# --- Oturum ---------------------------------------------------------------------
# Yerel HTTP testinde false; HTTPS (canlı) ortamında MUTLAKA true
SESSION_SECURE=false
SESSION_NAME=PORTFOLYO_SESSION
# Oturumu istemci IP önekine / tarayıcıya bağlar (çalınan çerezlere karşı). Yerelde "localhost" bazen
# ::1 ile 127.0.0.1 arasında geçiş yapıp oturumu düşürürse false yapabilirsiniz; canlıda true bırakın.
SESSION_IP_BAGLA=true
SESSION_UA_BAGLA=true
SESSION_BOSTA_DK=30
SESSION_MUTLAK_DK=480

# Ters vekil (Cloudflare, nginx proxy vb.) arkasında ve vekil X-Forwarded-For'u eziyorsa true
GUVENILIR_PROXY=false
# HTTPS canlıda true (Strict-Transport-Security gönderir)
HSTS=false

# Kurulum betiği (database/install.php) boşsa otomatik üretir. Değiştirirseniz 2FA gizli anahtarları çözülemez.
UYGULAMA_ANAHTARI=

# --- Tarayıcıdan kurulum (YALNIZCA SSH/komut satırı olmayan hostingler için) ----------
# Boş bırakın = kurulum sihirbazı KAPALI. SSH olmayan hostingde: en az 16 karakterlik rastgele bir değer yazın,
# https://alanadiniz.com/kurulum adresini açıp bu değeri girin; kurulum bitince bu satırı SİLİN.
KURULUM_TOKEN=

# --- Medya yükleme --------------------------------------------------------------
# Görsel (JPEG/PNG/WebP/GIF) ve video (MP4/WebM) en çok boyutları (MB).
# PHP'nin upload_max_filesize / post_max_size değerleri de en az bu kadar olmalıdır (bkz. docs/KURULUM.md).
YUKLEME_MAX_BOYUT_MB=5
YUKLEME_VIDEO_MAX_MB=50

# --- E-posta bildirimi (isteğe bağlı) ------------------------------------------
# İletişim formundan yeni mesaj geldiğinde size e-posta gönderir. MAIL_HOST boşsa gönderilmez;
# mesajlar yine yönetim panelinde görünür. Test: php bin/eposta-test.php
MAIL_HOST=
MAIL_PORT=587
# tls = STARTTLS (587) · ssl = örtülü TLS (465) · yok = şifresiz (yalnızca yerel test)
MAIL_SIFRELEME=tls
MAIL_KULLANICI=
MAIL_SIFRE=
# Boşsa MAIL_KULLANICI kullanılır. Gönderen adresi SMTP hesabınıza ait olmalıdır.
MAIL_GONDEREN=
# Boşsa panelde (Ayarlar) kayıtlı iletişim e-postası kullanılır.
MAIL_ALICI=

# --- Yedekleme --------------------------------------------------------------------
# php bin/yedekle.php komutunun tutacağı en yeni yedek sayısı
YEDEK_SAKLA=14

# --- Dış yedek hedefleri (isteğe bağlı) ---------------------------------------------
# Panelde Ayarlar → Yedekleme bölümünden açılır. Parolalar yalnızca burada tutulur.
# FTP / FTPS (çoğu hostingte veya ikinci bir hostingte yedek klasörü):
YEDEK_FTP_HOST=
YEDEK_FTP_PORT=21
YEDEK_FTP_KULLANICI=
YEDEK_FTP_SIFRE=
YEDEK_FTP_DIZIN=/yedekler
YEDEK_FTP_SSL=true
# WebDAV (Nextcloud, Koofr, pCloud vb.): https://sunucu/remote.php/dav/files/KULLANICI/yedekler
YEDEK_WEBDAV_URL=
YEDEK_WEBDAV_KULLANICI=
YEDEK_WEBDAV_SIFRE=

# --- Web-cron (cron/SSH olmayan hostingler) -------------------------------------------
# En az 16 karakterlik rastgele bir değer yazın; ardından cron-job.org gibi ücretsiz bir servisle günde bir
# https://alanadiniz.com/bakim/BURAYA_DEGER adresini çağırın (otomatik yedek, temizlik, günlük döndürme çalışır).
BAKIM_TOKEN=
